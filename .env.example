PORT=4000

# مفتاح توقيع الجلسات (اختياري).
# لو سبته فاضي، السيرفر هيعمل مفتاح عشوائي قوي لوحده ويحفظه في db/.jwt-secret.
# لو حبيت تحطه بنفسك: أي حروف وأرقام عشوائية، 32 حرف أو أكتر، وما تنسخش مثال من الإنترنت.
# JWT_SECRET=

# حساب المشرف اللي بيتعمل في أول تشغيل بس (لما قاعدة البيانات تكون فاضية).
# لو سبتهم فاضيين: البريد admin@rasokh.test وكلمة مرور عشوائية بتظهر مرة واحدة في شباك السيرفر.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# خلّيها 1 بس لو السيرفر ورا بروكسي بيضيف x-forwarded-for (زي Hugging Face)،
# عشان حد محاولات الدخول يشوف عنوان كل زائر صح. مع start.bat و Cloudflare Tunnel سيبها فاضية.
# TRUST_PROXY=1

# تأكيد البريد الإلكتروني عند التسجيل (اختياري). لو سبتهم فاضيين، التسجيل بيشتغل من غير تأكيد.
# مع Gmail: شغّل "التحقق بخطوتين" في حساب جوجل، وبعدين اعمل "كلمة مرور للتطبيقات" من
# https://myaccount.google.com/apppasswords وحطها في SMTP_PASS (مش كلمة مرور الإيميل العادية).
# بعد ما تعدّلهم اقفل شبابيك الموقع وشغّل start.bat من جديد.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=
# اختياري: اسم المرسل اللي بيظهر للطالب
# MAIL_FROM="رسوخ <youraddress@gmail.com>"
